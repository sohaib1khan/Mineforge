#!/usr/bin/env bash
# MineForge Docker-first helper — no local Python/Node required.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEPLOY="$ROOT/deploy"
COMPOSE=(docker compose -f "$DEPLOY/docker-compose.yml" --env-file "$DEPLOY/.env")
TEST_COMPOSE=(docker compose -f "$DEPLOY/docker-compose.test.yml")

die() { echo "error: $*" >&2; exit 1; }

load_env_vars() {
  [[ -f "$DEPLOY/.env" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    local key="${line%%=*}"
    local val="${line#*=}"
    val="${val%\"}"
    val="${val#\"}"
    val="${val%\'}"
    val="${val#\'}"
    case "$key" in
      MINEFORGE_HOST_PORT|MINEFORGE_PUBLIC_URL|MINEFORGE_COOKIE_SECURE|BEDROCK_DATA_HOST_PATH|MINEFORGE_BEDROCK_CONTAINER|BEDROCK_UID|BEDROCK_GID|MINEFORGE_RUNTIME_UID|MINEFORGE_RUNTIME_GID)
        export "$key=$val"
        ;;
    esac
  done < "$DEPLOY/.env"
}

upsert_env() {
  local key="$1"
  local val="$2"
  if grep -q "^${key}=" "$DEPLOY/.env" 2>/dev/null; then
    sed -i "s|^${key}=.*|${key}=${val}|" "$DEPLOY/.env"
  else
    printf '\n%s=%s\n' "$key" "$val" >> "$DEPLOY/.env"
  fi
  export "${key}=${val}"
}

# Discover the host path already mounted at /data on the live Bedrock container,
# or fall back to common ~/minecraft/data layouts.
detect_bedrock_data_path() {
  local name="${MINEFORGE_BEDROCK_CONTAINER:-bedrock}"
  local path=""

  if [[ -n "${BEDROCK_DATA_HOST_PATH:-}" ]]; then
    if [[ -d "${BEDROCK_DATA_HOST_PATH}" ]]; then
      echo "==> Using BEDROCK_DATA_HOST_PATH=${BEDROCK_DATA_HOST_PATH}"
      return 0
    fi
    echo "warning: BEDROCK_DATA_HOST_PATH=${BEDROCK_DATA_HOST_PATH} is missing on disk — re-detecting" >&2
  fi

  if docker inspect "$name" >/dev/null 2>&1; then
    path="$(
      docker inspect "$name" --format '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Source}}{{println}}{{end}}{{end}}' \
        | head -n1 | tr -d '\r'
    )"
    if [[ -n "$path" && -d "$path" ]]; then
      upsert_env BEDROCK_DATA_HOST_PATH "$path"
      echo "==> Auto-detected Bedrock /data from container '${name}': ${path}"
      return 0
    fi
  fi

  local candidate
  for candidate in \
    "${HOME}/minecraft/data" \
    /home/mcvm/minecraft/data \
    "${HOME}/bedrock/data" \
    /opt/minecraft/data
  do
    if [[ -d "${candidate}/worlds" || -f "${candidate}/server.properties" ]]; then
      upsert_env BEDROCK_DATA_HOST_PATH "$candidate"
      echo "==> Auto-detected Bedrock data at ${candidate}"
      return 0
    fi
  done

  echo "warning: could not auto-detect Bedrock data." >&2
  echo "         Set BEDROCK_DATA_HOST_PATH in deploy/.env to your server's data folder" >&2
  echo "         (the host path mounted as /data on the Bedrock container)." >&2
  return 1
}

ensure_env() {
  if [[ ! -f "$DEPLOY/.env" ]]; then
    echo "Creating deploy/.env from .env.example …"
    cp "$DEPLOY/.env.example" "$DEPLOY/.env"
    # Replace CHANGE_ME secret with a random value for local Docker.
    if command -v openssl >/dev/null 2>&1; then
      local key
      key="$(openssl rand -hex 32)"
      sed -i "s/^MINEFORGE_SECRET_KEY=.*/MINEFORGE_SECRET_KEY=${key}/" "$DEPLOY/.env"
    fi
    echo "Wrote $DEPLOY/.env — review before production use."
  fi
  load_env_vars
}

cmd_test() {
  echo "==> Backend tests (Docker)"
  "${TEST_COMPOSE[@]}" build backend-test
  "${TEST_COMPOSE[@]}" run --rm --no-deps backend-test

  echo "==> Frontend lint/typecheck/test/build (Docker)"
  # frontend-test stage already runs lint+typecheck+test+build at image build time
  docker build -f "$ROOT/Dockerfile" --target frontend-test -t mineforge-frontend-test:local "$ROOT"

  echo "==> All Docker tests passed"
}

cmd_up() {
  ensure_env
  # Attach existing server data before compose so the bind mount is applied.
  if [[ "${1:-}" != "bedrock" ]]; then
    detect_bedrock_data_path || true
    load_env_vars
    # Default runtime UID to Bedrock ownership so /data writes succeed.
    if [[ -z "${MINEFORGE_RUNTIME_UID:-}" ]]; then
      upsert_env MINEFORGE_RUNTIME_UID "${BEDROCK_UID:-1000}"
    fi
    if [[ -z "${MINEFORGE_RUNTIME_GID:-}" ]]; then
      upsert_env MINEFORGE_RUNTIME_GID "${BEDROCK_GID:-1000}"
    fi
    load_env_vars
  fi
  echo "==> Building and starting MineForge"
  "${COMPOSE[@]}" up -d --build --force-recreate socket-proxy mineforge
  if [[ "${1:-}" == "bedrock" ]]; then
    "${COMPOSE[@]}" --profile bedrock up -d --build bedrock
  fi
  # Surface a common attach failure early (proxy crash-loop → DNS errors in UI).
  sleep 3
  if ! docker ps --filter "name=mineforge-socket-proxy" --filter "status=running" --format '{{.Names}}' | grep -q .; then
    echo "error: socket-proxy is not running — Server/Docker controls will fail." >&2
    docker logs --tail=80 mineforge-socket-proxy-1 >&2 || true
    die "socket-proxy failed to stay up; fix the logs above, then re-run $0 up"
  fi
  if [[ -n "${BEDROCK_DATA_HOST_PATH:-}" ]]; then
    echo "==> Bedrock data bind: ${BEDROCK_DATA_HOST_PATH} → /data"
  else
    echo "==> Bedrock data: Compose volume bedrock-data (no existing server path detected)"
  fi
  echo "==> Waiting for health"
  local i
  for i in $(seq 1 40); do
    local port="${MINEFORGE_HOST_PORT:-18080}"
    if curl -fsS "http://127.0.0.1:${port}/api/health" >/dev/null 2>&1; then
      echo "Healthy: http://127.0.0.1:${port}"
      local needs
      needs="$(curl -fsS "http://127.0.0.1:${port}/api/setup/status" | sed -n 's/.*"needs_setup":\s*\(true\|false\).*/\1/p')"
      if [[ "$needs" == "true" ]]; then
        echo "==> First-run setup required — open the UI and create the admin account."
      else
        echo "==> Admin already exists — open the UI and sign in."
      fi
      local worlds
      worlds="$(docker exec mineforge-mineforge-1 sh -c 'ls -1 /data/worlds 2>/dev/null | wc -l' | tr -d '[:space:]')"
      if [[ "${worlds:-0}" == "0" ]]; then
        echo "warning: /data/worlds is empty inside the app container." >&2
        echo "         Existing worlds will not appear until BEDROCK_DATA_HOST_PATH points at your real data." >&2
        echo "         Example: BEDROCK_DATA_HOST_PATH=/home/mcvm/minecraft/data" >&2
      else
        echo "==> Found ${worlds} world folder(s) under /data/worlds"
      fi
      return 0
    fi
    sleep 2
  done
  die "mineforge did not become healthy; try: $0 logs"
}

cmd_down() {
  ensure_env
  "${COMPOSE[@]}" --profile bedrock down --remove-orphans
}

cmd_logs() {
  ensure_env
  "${COMPOSE[@]}" logs -f --tail=200 mineforge
}

cmd_reset() {
  ensure_env
  echo "==> Resetting app data (users/DB) for a fresh first-run setup"
  "${COMPOSE[@]}" stop mineforge >/dev/null 2>&1 || true
  "${COMPOSE[@]}" rm -f mineforge >/dev/null 2>&1 || true
  docker volume rm -f mineforge_mineforge-data >/dev/null 2>&1 || true
  "${COMPOSE[@]}" up -d --build socket-proxy mineforge
  echo "==> Waiting for health"
  local port="${MINEFORGE_HOST_PORT:-18080}"
  local i
  for i in $(seq 1 40); do
    if curl -fsS "http://127.0.0.1:${port}/api/health" >/dev/null 2>&1; then
      local status
      status="$(curl -fsS "http://127.0.0.1:${port}/api/setup/status")"
      echo "$status"
      if echo "$status" | grep -q '"needs_setup":true'; then
        echo "Open http://127.0.0.1:${port}/ — first-time setup will ask you to create the admin."
      else
        die "reset finished but needs_setup is still false"
      fi
      return 0
    fi
    sleep 2
  done
  die "mineforge did not become healthy after reset"
}

cmd_ps() {
  ensure_env
  "${COMPOSE[@]}" ps
}

cmd_smoke() {
  ensure_env
  local port="${MINEFORGE_HOST_PORT:-18080}"
  local base="http://127.0.0.1:${port}"
  echo "==> Smoke: health"
  curl -fsS "$base/api/health" | tee /tmp/mf-health.json
  echo
  echo "==> Smoke: setup status"
  curl -fsS "$base/api/setup/status" | tee /tmp/mf-setup.json
  echo
  echo "==> Smoke: SPA shell"
  curl -fsS -o /dev/null -w "index.html HTTP %{http_code}\n" "$base/"
  echo "OK"
}

usage() {
  cat <<EOF
MineForge Docker helper

Usage: $0 <command>

  test         Run backend + frontend tests in Docker
  up [bedrock] Build & start app (auto-detects existing Bedrock /data)
  attach       Detect Bedrock data path, write deploy/.env, recreate app
  reset        Wipe app DB volume and force first-run setup UI
  down         Stop stack
  logs         Follow app logs
  smoke        Hit health/setup/SPA endpoints
  ps           Show compose services
EOF
}

cmd_attach() {
  ensure_env
  detect_bedrock_data_path || die "could not detect Bedrock data — set BEDROCK_DATA_HOST_PATH manually"
  load_env_vars
  echo "==> Recreating MineForge with BEDROCK_DATA_HOST_PATH=${BEDROCK_DATA_HOST_PATH}"
  "${COMPOSE[@]}" up -d --build --force-recreate mineforge
  sleep 2
  echo "==> /data/worlds:"
  docker exec mineforge-mineforge-1 ls -la /data/worlds || true
  echo "Open the UI → Worlds / Add-ons / Server should reflect this folder."
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    test) cmd_test "$@" ;;
    up) cmd_up "$@" ;;
    attach) cmd_attach "$@" ;;
    reset) cmd_reset "$@" ;;
    down) cmd_down "$@" ;;
    logs) cmd_logs "$@" ;;
    smoke) cmd_smoke "$@" ;;
    ps) cmd_ps "$@" ;;
    ""|-h|--help|help) usage ;;
    *) die "unknown command: $cmd (try: help)" ;;
  esac
}

main "$@"
