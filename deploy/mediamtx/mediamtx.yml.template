###############################################
# MineForge MediaMTX config (no secrets).
# authHTTPAddress is set at runtime via MTX_AUTHHTTPADDRESS
# (the official image has no /bin/sh — do not use a shell entrypoint).
###############################################

logLevel: info
logDestinations: [stdout]

# Auth: MineForge validates publish keys; reads allowed for remux/proxy.
authMethod: http
# Overridden by compose env MTX_AUTHHTTPADDRESS (includes internal token).
authHTTPAddress:
authHTTPExclude:
  - action: api
  - action: metrics
  - action: pprof

api: yes
apiAddress: :9997

metrics: no
pprof: no
playback: no

rtsp: no
rtmp: yes
rtmpAddress: :1935
rtmpEncryption: "no"

hls: yes
hlsAddress: :8888
hlsEncryption: no
# Always remux so the first viewer does not wait for muxer warmup.
hlsAlwaysRemux: yes
# LL-HLS (~2–5s). Proxy must forward _HLS_* query params and tolerate gap.mp4.
hlsVariant: lowLatency
hlsSegmentCount: 4
hlsSegmentDuration: 1s
hlsPartDuration: 200ms
hlsSegmentMaxSize: 50M
hlsMuxerCloseAfter: 60s
hlsAllowOrigin: "*"

webrtc: no
srt: no

pathDefaults:
  source: publisher

paths:
  # OBS: Server rtmp://host:1935/live + Stream Key <name>?user=…&pass=…
  # Accept live/stream, live/live, live/obs, etc. (never a trailing-only slash).
  ~^live/.+:
