# MineForge — copy to deploy/.env and fill in. Never commit real values.
# For local Docker HTTP: keep PUBLIC_URL on http://localhost and COOKIE_SECURE=false.

MINEFORGE_PUBLIC_URL=http://localhost:18080
MINEFORGE_SECRET_KEY=CHANGE_ME_LONG_RANDOM
MINEFORGE_APP_DATA_DIR=/app-data
MINEFORGE_DATA_DIR=/data
MINEFORGE_HOST_PORT=18080
MINEFORGE_COOKIE_SECURE=false
MINEFORGE_BEDROCK_CONTAINER=bedrock
MINEFORGE_DOCKER_HOST=tcp://socket-proxy:2375
# Absolute host path to the existing Bedrock /data folder (worlds, server.properties).
# Leave unset to use the Compose named volume "bedrock-data" instead.
# Example: BEDROCK_DATA_HOST_PATH=/home/mcvm/minecraft/data
# BEDROCK_DATA_HOST_PATH=
MINEFORGE_BACKUP_RETENTION_DAYS=7
MINEFORGE_UPLOAD_MAX_MB=512
MINEFORGE_LOGWATCH_ENABLED=true
MINEFORGE_METRICS_ENABLED=true
MINEFORGE_METRICS_SAMPLE_SECONDS=30
MINEFORGE_METRICS_RETENTION_DAYS=30
MINEFORGE_PUBLIC_IP_LOOKUP_URL=https://api.ipify.org
# Only enable behind a trusted reverse proxy that overwrites forwarded headers:
MINEFORGE_TRUST_PROXY_HEADERS=false

# Stream (OBS → MediaMTX → MineForge HLS proxy). Placeholders only.
# RTMP :1935 is published for remote OBS. Forward TCP 1935 on your firewall/router.
# Bind IP 0.0.0.0 = all interfaces; set a LAN IP to restrict to that interface only.
# HLS/API stay internal (not published) — viewers use MineForge /api/stream/hls.
MEDIAMTX_RTMP_BIND_IP=0.0.0.0
MINEFORGE_STREAM_ENABLED=true
# Hostname OBS uses (your public DNS). Leave empty to use MINEFORGE_PUBLIC_URL host.
MINEFORGE_STREAM_RTMP_HOST=mineforge.example.com
MINEFORGE_INTERNAL_STREAM_SECRET=CHANGE_ME_INTERNAL_STREAM_SECRET
MINEFORGE_MEDIAMTX_HLS_URL=http://mediamtx:8888
MINEFORGE_MEDIAMTX_API_URL=http://mediamtx:9997

TZ=UTC


# Bedrock (only used with: docker compose --profile bedrock up -d)
BEDROCK_VERSION=CHANGE_ME_PINNED_VERSION
BEDROCK_IMAGE_TAG=latest
BEDROCK_UID=1000
BEDROCK_GID=1000
# MineForge process UID/GID (defaults to BEDROCK_* so allowlist writes work).
MINEFORGE_RUNTIME_UID=1000
MINEFORGE_RUNTIME_GID=1000
SERVER_UDP_PORTS='<public_ip>:19140-19155:19140-19155'
